ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5180

SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=opetional_agents
SQL_DRIVER={ODBC Driver 17 for SQL Server}
SQL_TRUSTED_CONNECTION=yes

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Auth. JWT_SECRET must be a long random value (python -c "import secrets;print(secrets.token_urlsafe(48))").
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Password reset by emailed code
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5

# Outgoing mail (leave SMTP_HOST empty in development: emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Automatic agents -------------------------------------------------------------------------
# Master switch for the background worker (quote chasing, ranking, delivery chasing, mailbox reading).
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60
NEGOTIATE_ENABLED=false
NEGOTIATE_WAIT_HOURS=24
AUTO_REORDER_ENABLED=false
AUTO_REORDER_MAX_PER_PASS=3
AUTO_REORDER_COOLDOWN_HOURS=24
LOOP_RESTARTS_PER_HOUR=3

# Inbound mailbox where suppliers reply. Use a DEDICATED mailbox: handled replies are marked read.
# Use the same address as SMTP_FROM so replies come back here. Leave IMAP_HOST empty to enter quotes by hand.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Link used in alert emails (the address your team opens in the browser)
APP_BASE_URL=http://localhost:5180

# Human-approval rules: an order is approved automatically ONLY if all of these hold
AUTO_APPROVE_MAX_AMOUNT=50000
AUTO_APPROVE_MIN_RELIABILITY=4.0
AUTO_APPROVE_MIN_QUOTES=2
# ...and today's automatic approvals have not already added up to this much
AUTO_APPROVE_DAILY_LIMIT=200000
# An invoice may differ from the purchase order by up to this percent and still match
INVOICE_AMOUNT_TOLERANCE_PCT=1.0
TAX_RATE_PCT=0
TAX_INCLUDED_IN_QUOTES=false

# Supplier timing
RFQ_DEADLINE_HOURS=48
RFQ_REMINDER_HOURS=24
RFQ_MAX_REMINDERS=2
DELIVERY_CHASE_INTERVAL_HOURS=24
DELIVERY_MAX_CHASES=2
APPROVAL_REMINDER_HOURS=24
APPROVAL_MAX_REMINDERS=3

# Abuse protection
MAX_REQUESTS_PER_USER_PER_DAY=20
DUPLICATE_REQUEST_MINUTES=10
HELD_CASE_GRACE_MINUTES=5

# ---- Demo phone calls (Twilio) -------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Spoken when they answer, then the call ends. Empty = hang up the moment they pick up.
TWILIO_ANSWER_MESSAGE=
# What runs when they answer. The default is Twilio's own template (the only thing a free trial allows).
# Set to empty on a paid account to hang up / say TWILIO_ANSWER_MESSAGE instead.
TWILIO_ANSWER_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_auto_response
# "twilio" or "exotel"; empty = Twilio if set up, else Exotel
CALL_PROVIDER=

# "Please check your email" calls to vendors after we email them (Hindi / Marathi / English).
# Needs a PAID Twilio account with TWILIO_ANSWER_URL empty. Vendors need a phone number and a language set.
CALL_AFTER_EMAIL=false
CALL_COMPANY_NAME=Cognexa
CALL_HOURS_START=9
CALL_HOURS_END=19

# ---- Demo phone calls (Exotel) ------------------------------------------------------------------
# Dashboard: Settings -> API Settings. Put the token here only, never in chat or git.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your ExoPhone, as shown at my.exotel.com/numbers
EXOTEL_FROM_NUMBER=
# The call flow to run when the person answers (its id is in the flow's URL), or a second number to connect to
EXOTEL_APP_ID=
EXOTEL_CONNECT_TO=
EXOTEL_HOST=api.in.exotel.com
# Hang up this many seconds into the call (0 = let it run). 3 = ring, then cut soon after they pick up.
EXOTEL_TIME_LIMIT=0
# Optional: only these numbers may be rung (comma separated, with country code)
CALL_ALLOWED_NUMBERS=

# Printed on purchase orders and approval summaries (address lines separated by |)
COMPANY_NAME=Cognexa
COMPANY_ADDRESS=

# Morning e-mail to each department (off until switched on here or in Settings -> Configure)
DESK_SUMMARY_ENABLED=true
DESK_SUMMARY_HOUR=9

# One e-mail a week to the admins (day 0 = Monday, hour in India time)
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=9
